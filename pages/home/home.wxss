/* 首页背景：宣纸远山图，固定铺满，卡片浮在上面 */
.home-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* 自定义标题栏：只占状态栏 + 44px，背景图从屏幕最顶端开始 */
.home-nav {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.home-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
}

.page {
  position: relative;
  z-index: 1;
  /* 标题栏已经占掉了状态栏高度，再按 100vh 撑高就会多出可滚动的空白 */
  min-height: 0;
}

.entry-card {
  position: relative;
  display: flex;
  align-items: center;
  margin-bottom: var(--gap-md);
  padding: var(--gap-lg);
  /* 留一点透光，让纸纹透上来，卡片才不像贴纸 */
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-card);
  box-shadow: 0 6rpx 20rpx rgba(43, 43, 43, 0.07);
}

.entry-head {
  display: flex;
  align-items: baseline;
}

.entry-name {
  font-size: 38rpx;
  line-height: 52rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  color: var(--ink);
}

.entry-en {
  margin-left: 12rpx;
  padding-bottom: 2rpx;
  font-size: 20rpx;
  line-height: 24rpx;
  letter-spacing: 3rpx;
  color: var(--tint);
  border-bottom: 1rpx solid var(--sage);
}

.entry-foot {
  display: flex;
  align-items: center;
  margin-top: 6rpx;
}

.entry-desc {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  line-height: 36rpx;
  color: var(--label-2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 插画预留位：放置 /assets/art/*.png 后由 .entry-art 接管右上角 */
.entry-art {
  position: absolute;
  right: var(--gap-md);
  bottom: 12rpx;
  width: 128rpx;
  height: 128rpx;
  pointer-events: none;
}
