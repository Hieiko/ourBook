/* 记账页没有底栏，收掉 app.wxss 给 tab 页留的那截空白 */
.page {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.month-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--gap-sm);
}

.month-nav {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  line-height: 1;
  color: var(--tint);
}

.month-text {
  min-width: 240rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
}

/* ---------- 汇总卡：结余为主，收支为辅 ---------- */
.summary {
  display: flex;
  align-items: center;
  margin-bottom: var(--gap-md);
  padding: 26rpx var(--gap-lg);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-card);
  background: var(--card);
}

.summary-main {
  flex: 1;
  min-width: 0;
}

.summary-label {
  display: block;
  font-size: 26rpx;
  line-height: 36rpx;
  color: var(--label-2);
}

.summary-balance {
  display: block;
  margin-top: 2rpx;
  font-size: 54rpx;
  line-height: 66rpx;
  font-weight: 600;
}

.summary-side {
  flex: none;
  text-align: right;
}

.summary-line {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  font-size: 28rpx;
  line-height: 42rpx;
}

.summary-key {
  margin-right: 12rpx;
  color: var(--label-2);
}

/* ---------- 支出 / 收入 切换 ---------- */
.seg {
  display: flex;
  margin-bottom: var(--gap-sm);
  padding: 4rpx;
  border-radius: 18rpx;
  background: var(--fill);
}

.seg-item {
  flex: 1;
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  font-size: 30rpx;
}

.seg-item.on {
  background: var(--card);
  font-weight: 600;
  box-shadow: 0 3rpx 8rpx rgba(43, 43, 43, 0.1);
}

/* ---------- icon 网格：一屏点选，点谁记谁 ---------- */
.grid {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: var(--gap-lg);
}

.cell {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18rpx 0;
}

.cell-tile {
  width: 128rpx;
  height: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--tint-soft);
}

.cell-name {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 34rpx;
  color: var(--label-2);
}

.grid.expense .icon { background-color: var(--tint); }
.grid.income .cell-tile { background: rgba(53, 120, 79, 0.12); }
.grid.income .icon { background-color: var(--income); }

/* 记录行：分类图标沿用圆形底 */
.tile {
  border-radius: 50%;
}

.tile.expense { background: var(--tint-soft); }
.tile.expense .icon { background-color: var(--tint); }
.tile.income { background: rgba(53, 120, 79, 0.12); }
.tile.income .icon { background-color: var(--income); }

/* ---------- 金额弹层 ---------- */
.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.4);
}

.sheet {
  width: 100%;
  box-sizing: border-box;
  padding: 8rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background: var(--bg);
  border-radius: 32rpx 32rpx 0 0;
}

.grabber {
  width: 72rpx;
  height: 10rpx;
  margin: 8rpx auto 0;
  border-radius: 999rpx;
  background: var(--label-3);
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
}

.sheet-title { font-size: 34rpx; font-weight: 600; }
.sheet-cancel { font-size: 34rpx; color: var(--tint); }
.sheet-done { font-size: 34rpx; font-weight: 600; color: var(--tint); }

.amount-row {
  display: flex;
  align-items: center;
  padding: 8rpx var(--gap-lg) 32rpx;
}

.cny {
  margin-right: 12rpx;
  font-size: 44rpx;
  font-weight: 600;
  color: var(--label-2);
}

.amount-field {
  flex: 1;
  min-width: 0;
  font-size: 64rpx;
  line-height: 76rpx;
  font-weight: 700;
}

.field-input {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  text-align: right;
}

.btn-delete {
  margin-top: 8rpx;
  background: rgba(176, 74, 62, 0.12);
  color: var(--expense);
}
