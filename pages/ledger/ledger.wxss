.month-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 0 24rpx;
}

.month-nav {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  line-height: 1;
  color: var(--tint);
}

.month-text {
  min-width: 240rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
}

.balance-value {
  font-size: 44rpx;
  font-weight: 600;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  line-height: 1;
  color: #FFFFFF;
  border-radius: 50%;
  background: var(--tint);
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.18);
}

.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.4);
}

.sheet {
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  box-sizing: border-box;
  padding: 8rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background: var(--bg);
  border-radius: 20rpx 20rpx 0 0;
}

.grabber {
  width: 72rpx;
  height: 10rpx;
  margin: 8rpx auto 0;
  border-radius: 999rpx;
  background: var(--label-3);
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
}

.sheet-title { font-size: 34rpx; font-weight: 600; }
.sheet-cancel { font-size: 34rpx; color: var(--tint); }
.sheet-done { font-size: 34rpx; font-weight: 600; color: var(--tint); }

.seg {
  display: flex;
  margin-bottom: 32rpx;
  padding: 4rpx;
  border-radius: 18rpx;
  background: var(--fill);
}

.seg-item {
  flex: 1;
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  font-size: 30rpx;
}

.seg-item.on {
  background: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 3rpx 8rpx rgba(0, 0, 0, 0.12), 0 1rpx 1rpx rgba(0, 0, 0, 0.04);
}

.field-input {
  flex: 1;
  font-size: 34rpx;
  text-align: right;
}

.amount-input {
  font-size: 44rpx;
  font-weight: 600;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  padding: 24rpx 24rpx 8rpx;
}

.chip {
  margin: 0 16rpx 16rpx 0;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  background: var(--fill);
}

.chip.on {
  background: var(--tint-soft);
  color: var(--tint);
  font-weight: 600;
}

.btn-delete {
  margin-top: 8rpx;
  background: rgba(194, 94, 82, 0.14);
  color: var(--expense);
}
