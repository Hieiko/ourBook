<view class="page">
  <view class="month-bar">
    <view
      class="month-nav pressable"
      hover-class="pressed"
      hover-stay-time="80"
      data-delta="-1"
      bindtap="shiftMonth"
      aria-role="button"
      aria-label="上一个月"
    >‹</view>
    <text class="month-text">{{monthLabel}}</text>
    <view
      class="month-nav pressable"
      hover-class="pressed"
      hover-stay-time="80"
      data-delta="1"
      bindtap="shiftMonth"
      aria-role="button"
      aria-label="下一个月"
    >›</view>
  </view>

  <view class="group">
    <view class="row">
      <text class="row-title">本月结余</text>
      <text class="balance-value">{{summary.balance}}</text>
    </view>
    <view class="row">
      <text class="row-title">支出</text>
      <text class="row-value amount-expense">{{summary.expense}}</text>
    </view>
    <view class="row">
      <text class="row-title">收入</text>
      <text class="row-value amount-income">{{summary.income}}</text>
    </view>
    <view
      class="row pressable"
      hover-class="pressed"
      hover-stay-time="80"
      bindtap="openSummary"
      aria-role="button"
      aria-label="查看支出分类排行"
    >
      <text class="row-title">分类汇总</text>
      <text class="row-value row-link">查看排行 ›</text>
    </view>
  </view>

  <view class="group-header">本月记录 · {{list.length}} 笔</view>
  <view class="group">
    <view wx:if="{{!list.length}}" class="row row-empty">本月还没有记录</view>
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="row pressable"
      hover-class="pressed"
      hover-stay-time="80"
      data-id="{{item.id}}"
      bindtap="openEdit"
      aria-role="button"
      aria-label="{{item.category}}{{item.type === 'income' ? '收入' : '支出'}} {{item.amountText}}，点击编辑"
    >
      <view class="badge {{item.type}}" aria-hidden="true">{{item.type === 'income' ? '收' : '支'}}</view>
      <view class="entry-body">
        <text class="entry-title">{{item.category}}</text>
        <text class="entry-sub">{{item.dateText}}{{item.note ? ' · ' + item.note : ''}}</text>
      </view>
      <text class="amount {{item.type}}">{{item.type === 'income' ? '+' : '-'}}{{item.amountText}}</text>
    </view>
  </view>

  <view
    class="fab pressable"
    hover-class="pressed"
    hover-stay-time="80"
    bindtap="openNew"
    aria-role="button"
    aria-label="记一笔"
  >＋</view>
</view>

<view wx:if="{{sheetVisible}}" class="mask" bindtap="closeSheet">
  <view class="sheet" catchtap="noop">
    <view class="grabber" aria-hidden="true"></view>

    <view class="sheet-head">
      <text class="sheet-cancel pressable" hover-class="pressed" hover-stay-time="80" bindtap="closeSheet" aria-role="button">取消</text>
      <text class="sheet-title">{{form.id ? '编辑记录' : '记一笔'}}</text>
      <text class="sheet-done pressable" hover-class="pressed" hover-stay-time="80" bindtap="save" aria-role="button">保存</text>
    </view>

    <view class="seg">
      <view
        class="seg-item {{form.type === 'expense' ? 'on' : ''}}"
        data-value="expense"
        bindtap="onType"
        aria-role="radio"
        aria-checked="{{form.type === 'expense'}}"
      >支出</view>
      <view
        class="seg-item {{form.type === 'income' ? 'on' : ''}}"
        data-value="income"
        bindtap="onType"
        aria-role="radio"
        aria-checked="{{form.type === 'income'}}"
      >收入</view>
    </view>

    <view class="group">
      <view class="row">
        <text class="row-title">金额</text>
        <input class="field-input amount-input" type="digit" placeholder="0.00" value="{{form.amount}}" bindinput="onAmount" aria-label="金额" />
      </view>
      <view class="row">
        <text class="row-title">日期</text>
        <picker mode="date" value="{{form.dateStr}}" bindchange="onDate" aria-label="选择日期">
          <view class="row-value">{{form.dateStr}}</view>
        </picker>
      </view>
      <view class="row">
        <text class="row-title">备注</text>
        <input class="field-input note-input" placeholder="选填" value="{{form.note}}" bindinput="onNote" aria-label="备注" />
      </view>
    </view>

    <view class="group-header">分类</view>
    <view class="group">
      <view class="chips">
        <view
          wx:for="{{categories}}"
          wx:key="*this"
          class="chip {{form.category === item ? 'on' : ''}}"
          data-value="{{item}}"
          bindtap="onCategory"
          aria-role="radio"
          aria-checked="{{form.category === item}}"
        >{{item}}</view>
      </view>
    </view>

    <view wx:if="{{form.id}}" class="btn btn-delete pressable" hover-class="pressed" hover-stay-time="80" bindtap="removeCurrent" aria-role="button">删除这笔记录</view>
  </view>
</view>
