<nav-bar title="分类汇总" back />
<view class="page">
  <view class="group-header">{{monthLabel}} · 支出</view>
  <view class="group">
    <view class="row">
      <text class="row-title">支出合计</text>
      <text class="row-value amount-expense">{{expenseText}}</text>
    </view>
    <view class="row">
      <text class="row-title">上月支出</text>
      <text class="row-value">{{prevExpenseText}}</text>
    </view>
    <view class="row">
      <text class="row-title">环比</text>
      <text class="row-value mom {{momClass}}">{{momText}}</text>
    </view>
  </view>

  <view class="group-header">支出分类排行</view>
  <view class="group">
    <view wx:if="{{!rank.length}}" class="row row-empty">本月没有支出记录</view>
    <view wx:for="{{rank}}" wx:key="category" class="rank">
      <view class="rank-line">
        <text class="rank-name">{{item.category}}</text>
        <text class="rank-amount">{{item.amountText}} · {{item.percent}}%</text>
      </view>
      <view class="bar-track">
        <view class="bar-fill" style="width: {{item.width}}%"></view>
      </view>
    </view>
  </view>
</view>
