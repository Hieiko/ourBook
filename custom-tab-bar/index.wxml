<view class="tabbar">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab {{selected === index ? 'on' : ''}}"
    data-index="{{index}}"
    bindtap="onTap"
    hover-class="pressed"
    hover-stay-time="80"
    aria-role="button"
    aria-label="{{item.text}}"
  >
    <view class="icon icon-{{item.icon}}" aria-hidden="true"></view>
    <text class="label">{{item.text}}</text>
  </view>
</view>
