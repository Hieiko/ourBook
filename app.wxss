/* app.wxss —— 色系参考「古德墨柠」：墨绿 + 暖白 + 墨色
 * 间距/字号沿用 Apple HIG（iPhone pt ×2 = rpx）
 * 所有承载文字的颜色均已按 WCAG AA 4.5:1 校验；仅装饰性色块用浅色 */
page {
  /* 品牌色：深墨绿承载文字与图标，浅墨绿只做装饰 */
  --tint: #4F7261;                       /* 5.37:1 on white */
  --tint-soft: rgba(79, 114, 97, 0.12);
  --sage: #7C9E8A;                       /* 仅装饰 */
  --sage-soft: rgba(124, 158, 138, 0.16);
  --seal: #C0524A;                       /* 4.62:1 */
  --orange: #B0762C;                     /* 3.84:1，仅图标 */

  /* 语义色 */
  --income: #35784F;                     /* 5.31:1 */
  --expense: #B04A3E;                    /* 5.39:1 */

  /* 背景与前景 */
  --bg: #F7F6F2;
  --card: #FFFFFF;
  --ink: #2B2B2B;
  --label: #2B2B2B;
  --label-2: #64645F;                    /* 5.95:1，辅助文字 */
  --label-3: #8A867C;                    /* 3.5:1，箭头等非文字控件 */
  --separator: #EAE7DF;
  --border: #EAE7DF;
  --fill: #F1EFEA;

  /* 间距节奏 4/8rpx 递增 */
  --gap-xs: 8rpx;
  --gap-sm: 16rpx;
  --gap-md: 24rpx;
  --gap-lg: 32rpx;

  /* 圆角与图标尺寸 token */
  --radius-card: 16rpx;
  --radius-group: 20rpx;
  --icon-sm: 40rpx;
  --icon-md: 48rpx;
  --icon-lg: 96rpx;
  --icon-xl: 132rpx;

  background: var(--bg);
  color: var(--label);
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro SC", "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 34rpx;
  line-height: 44rpx;
}

/* 字号阶梯 */
.large-title { font-size: 68rpx; line-height: 82rpx; font-weight: 700; }
.headline    { font-size: 34rpx; line-height: 44rpx; font-weight: 600; }
.subhead     { font-size: 30rpx; line-height: 40rpx; }
.footnote    { font-size: 26rpx; line-height: 36rpx; color: var(--label-2); }
.caption     { font-size: 24rpx; line-height: 32rpx; color: var(--label-2); }

/* 宋体标题，贴合参考图的中式书卷感 */
.ink-title {
  font-family: "Songti SC", "STSongti-SC-Bold", "Noto Serif SC", "Source Han Serif SC", serif;
}

.page {
  box-sizing: border-box;
  padding: 24rpx 32rpx 220rpx;
}

/* ---------- 图标系统：一套线性 SVG，蒙版上色，尺寸走 token ---------- */
.icon {
  flex: none;
  width: var(--icon-md);
  height: var(--icon-md);
  background-color: var(--label-2);
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center;
  -webkit-mask-size: 100% 100%;
  mask-repeat: no-repeat;
  mask-position: center;
  mask-size: 100% 100%;
}

.icon-sm { width: var(--icon-sm); height: var(--icon-sm); }
.icon-lg { width: var(--icon-lg); height: var(--icon-lg); }
.icon-xl { width: var(--icon-xl); height: var(--icon-xl); }

.c-sage   { background-color: var(--tint); }
.c-orange { background-color: var(--orange); }
.c-seal   { background-color: var(--seal); }
.c-ink    { background-color: var(--ink); }
.c-muted  { background-color: var(--label-3); }

