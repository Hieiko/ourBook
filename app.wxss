/* ---------- 分组列表（inset grouped） ---------- */
.group {
  margin-bottom: var(--gap-lg);
  border-radius: var(--radius-group);
  background: var(--card);
  overflow: hidden;
}

.group-header,
.group-footer {
  padding: 0 var(--gap-sm) 12rpx;
  font-size: 26rpx;
  line-height: 36rpx;
  color: var(--label-2);
}

.group-footer {
  padding: 12rpx var(--gap-sm) 0;
  margin-bottom: var(--gap-lg);
}

.row {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 88rpx;                     /* 44pt 最小点击高度 */
  padding: 20rpx var(--gap-lg);
}

.row + .row {
  border-top: 1rpx solid var(--separator);
}

.row-title {
  flex: 1;
  font-size: 34rpx;
}

.row-value {
  font-size: 34rpx;
  color: var(--label-2);
}

.row-empty {
  justify-content: center;
  color: var(--label-2);
}

.chevron {
  margin-left: 12rpx;
  font-size: 38rpx;
  line-height: 1;
  color: var(--label-3);
}

/* 列表左侧图标块：44pt 命中区 */
.tile {
  flex: none;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: var(--fill);
}

.tile-ledger { background: var(--tint-soft); }
.tile-meal   { background: rgba(176, 118, 44, 0.14); }
.tile-lottery { background: rgba(192, 82, 74, 0.12); }

.badge {
  flex: none;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.badge.expense { background: rgba(176, 74, 62, 0.12); color: var(--expense); }
.badge.income  { background: rgba(53, 120, 79, 0.12); color: var(--income); }

/* 行内两段式文案 */
.entry-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
}

.entry-title { font-size: 34rpx; line-height: 44rpx; }
.entry-sub {
  margin-top: 2rpx;
  font-size: 26rpx;
  line-height: 36rpx;
  color: var(--label-2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.amount { font-size: 34rpx; font-weight: 600; }
.amount.expense, .amount-expense { color: var(--expense); }
.amount.income, .amount-income  { color: var(--income); }

.tag {
  flex: none;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--label-2);
  background: var(--fill);
}

/* ---------- 按压反馈：不改变布局尺寸，避免抖动 ---------- */
.pressed {
  transform: scale(0.97);
  opacity: 0.72;
}

.pressable {
  transition: transform 120ms ease-out, opacity 120ms ease-out;
}

/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  border-radius: var(--radius-group);
  font-size: 34rpx;
  font-weight: 600;
}

.btn-filled { background: var(--tint); color: #FFFFFF; }
.btn-tinted { background: var(--tint-soft); color: var(--tint); }

/* ---------- 占位页（用餐 / 彩券 尚未开工） ---------- */
.placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 72rpx 48rpx;
  text-align: center;
}

.ph-icon {
  width: 176rpx;
  height: 176rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--fill);
}

.ph-title { margin-top: var(--gap-md); font-size: 40rpx; line-height: 48rpx; font-weight: 600; }
.ph-desc { margin-top: var(--gap-sm); font-size: 30rpx; line-height: 44rpx; color: var(--label-2); }
.ph-tag {
  margin-top: var(--gap-lg);
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--tint);
  background: var(--tint-soft);
}
